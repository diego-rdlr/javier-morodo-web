---
/**
 * "Solicitar una conferencia": la abre cualquier elemento con data-abrir="solicitud-conferencia".
 * Formulario de HubSpot "Solicitud de conferencia"; el segmento "Solicitudes de conferencia"
 * (lista 461) se llena solo. Los `value` de los desplegables son los valores internos en HubSpot.
 */
import DialogoFormulario from './ui/DialogoFormulario.astro';

const opciones = {
  tipo: ['Conferencia', 'Taller', 'Panel', 'Otro'],
  modalidad: ['Presencial', 'Virtual'],
  audiencia: ['Menos de 100', '100 a 500', '500 a 1,000', 'Más de 1,000'],
  // Lada del WhatsApp. México primero (la mayoría), luego Norteamérica, Latinoamérica y España.
  ladas: [
    ['🇲🇽', '+52', 'México'],
    ['🇺🇸', '+1', 'Estados Unidos'],
    ['🇨🇦', '+1', 'Canadá'],
    ['🇨🇴', '+57', 'Colombia'],
    ['🇦🇷', '+54', 'Argentina'],
    ['🇨🇱', '+56', 'Chile'],
    ['🇵🇪', '+51', 'Perú'],
    ['🇪🇸', '+34', 'España'],
    ['🇧🇷', '+55', 'Brasil'],
    ['🇪🇨', '+593', 'Ecuador'],
    ['🇺🇾', '+598', 'Uruguay'],
    ['🇵🇾', '+595', 'Paraguay'],
    ['🇧🇴', '+591', 'Bolivia'],
    ['🇻🇪', '+58', 'Venezuela'],
    ['🇵🇦', '+507', 'Panamá'],
    ['🇨🇷', '+506', 'Costa Rica'],
    ['🇬🇹', '+502', 'Guatemala'],
    ['🇸🇻', '+503', 'El Salvador'],
    ['🇭🇳', '+504', 'Honduras'],
    ['🇳🇮', '+505', 'Nicaragua'],
    ['🇩🇴', '+1', 'República Dominicana'],
    ['🇵🇷', '+1', 'Puerto Rico'],
  ],
  tema: [
    'Mentalidad patrimonial',
    'Educación financiera para todos',
    'El dinero y las máquinas',
    'Activos alternativos y digitales',
    'Otro',
  ],
};
---

<DialogoFormulario
  id="solicitud-conferencia"
  formulario="3000fb2b-f8bc-4e8f-9e65-e156ee250305"
  kicker="Conferencias"
  titulo="Solicita una conferencia"
  bajada="Cuéntanos de tu evento y nuestro equipo se pondrá en contacto contigo."
  boton="Enviar solicitud"
  exitoTitulo="Gracias. Recibimos tu solicitud."
>
  <fieldset class="solicitud__grupo">
    <legend class="mini">Tus datos</legend>
    <label>Nombre <input name="firstname" required autocomplete="given-name" /></label>
    <label>Apellido <input name="lastname" required autocomplete="family-name" /></label>
    <label>Correo <input name="email" type="email" required autocomplete="email" /></label>
    <div class="solicitud__telefono">
      <span id="solicitud-conferencia-whatsapp">WhatsApp</span>
      <div class="solicitud__telefono-campos">
        {/* Sin `name`: la lada se une al número en `phone` antes de enviar a HubSpot. */}
        <select data-lada aria-label="Lada del país" autocomplete="tel-country-code">
          {opciones.ladas.map(([bandera, lada, pais]) => <option value={lada} title={pais}>{bandera} {lada}</option>)}
        </select>
        <input
          name="phone"
          type="tel"
          required
          autocomplete="tel-national"
          placeholder="55 1234 5678"
          aria-labelledby="solicitud-conferencia-whatsapp"
        />
      </div>
    </div>
    <label>Organización <input name="company" required autocomplete="organization" /></label>
    <label>Cargo <input name="jobtitle" autocomplete="organization-title" /></label>
  </fieldset>

  <fieldset class="solicitud__grupo">
    <legend class="mini">Tu evento</legend>
    <label>
      Tipo de evento
      <select name="tipo_de_evento" required>
        <option value="">Elige una opción</option>
        {opciones.tipo.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label>
      Modalidad
      <select name="modalidad_del_evento" required>
        <option value="">Elige una opción</option>
        {opciones.modalidad.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label>Fecha tentativa <input name="fecha_tentativa_del_evento" required placeholder="Ej. marzo 2027" /></label>
    <label>Ciudad <input name="ciudad_del_evento" required placeholder="Ej. Monterrey, México" /></label>
    <label class="solicitud__ancho">
      Tamaño de la audiencia
      <select name="tamano_de_la_audiencia" required>
        <option value="">Elige una opción</option>
        {opciones.audiencia.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label class="solicitud__ancho">
      Tema de interés
      <select name="tema_de_interes" required>
        <option value="">Elige una opción</option>
        {opciones.tema.map((o) => <option value={o}>{o}</option>)}
      </select>
    </label>
    <label class="solicitud__ancho">
      Cuéntanos más (opcional)
      <textarea name="message" rows="3" placeholder="Perfil de la audiencia, objetivo del evento, otros detalles."></textarea>
    </label>
  </fieldset>
</DialogoFormulario>
