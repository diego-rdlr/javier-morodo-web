---
/**
 * "Contacto" general: lo abre cualquier elemento con data-abrir="contacto-formulario".
 * (El id no es "contacto" porque ese es el ancla del footer.)
 * Formulario de HubSpot "Contacto Javier Morodo" (segmento "Contacto desde la web", lista 464).
 * HubSpot solo notifica a usuarios de la cuenta; el aviso a info@revoluciondelariqueza.com lo manda
 * el Zap "JM Web · Aviso info@ · Contacto Javier Morodo".
 */
import DialogoFormulario from './ui/DialogoFormulario.astro';
---

<DialogoFormulario
  id="contacto-formulario"
  formulario="eb44c7c7-0e8c-40e1-8851-42c5ad2ea586"
  kicker="Contacto"
  titulo="Escríbenos"
  bajada="Déjanos tu mensaje y nuestro equipo se pondrá en contacto contigo."
  boton="Enviar mensaje"
>
  <fieldset class="solicitud__grupo">
    <legend class="sr-only">Tus datos</legend>
    <label>Nombre <input name="firstname" required autocomplete="given-name" /></label>
    <label>Apellido <input name="lastname" required autocomplete="family-name" /></label>
    <label class="solicitud__ancho">Correo <input name="email" type="email" required autocomplete="email" /></label>
    <label class="solicitud__ancho">
      Mensaje
      <textarea name="message" rows="5" required placeholder="¿En qué te podemos ayudar?"></textarea>
    </label>
  </fieldset>
</DialogoFormulario>
