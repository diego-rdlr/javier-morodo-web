---
/**
 * Encabezado de sección (Figma · "Encabezado de sección"):
 * acento eléctrico arriba + icono 72×72 + etiqueta mono + regla.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icono: ImageMetadata;
  etiqueta: string;
  tono?: 'oscuro' | 'claro';
  acento?: boolean;
}

const { icono, etiqueta, tono = 'oscuro', acento = true } = Astro.props;
---

{acento && <span class="acento" aria-hidden="true" />}
<div class:list={['encabezado', `encabezado--${tono}`]}>
  <span class="encabezado__icono" aria-hidden="true">
    <Image src={icono} alt="" width={66} height={66} />
  </span>
  <p class="encabezado__etiqueta">{etiqueta}</p>
  <span class="encabezado__regla" aria-hidden="true"></span>
</div>

<style>
  .acento {
    position: absolute;
    top: 0;
    left: max(var(--gutter), (100% - var(--contenido)) / 2);
    width: 140px;
    height: 5px;
    background: var(--marca-electrico);
  }

  .encabezado {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .encabezado__icono {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    background: var(--marca-electrico);
    overflow: hidden;
  }

  .encabezado__icono :global(img) {
    width: 66px;
    height: 66px;
    object-fit: contain;
  }

  .encabezado__etiqueta {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .encabezado__regla {
    flex: 1 1 0;
    min-width: 24px;
    height: 1px;
  }

  .encabezado--oscuro .encabezado__etiqueta {
    color: var(--marca-hielo);
  }

  .encabezado--oscuro .encabezado__regla {
    background: var(--texto-claro);
  }

  .encabezado--claro .encabezado__etiqueta {
    color: var(--texto-tinta);
  }

  .encabezado--claro .encabezado__regla {
    background: var(--texto-tinta);
  }

  @media (max-width: 640px) {
    .encabezado {
      gap: 14px;
    }
    .encabezado__icono {
      width: 52px;
      height: 52px;
      border-radius: 10px;
    }
    .encabezado__icono :global(img) {
      width: 48px;
      height: 48px;
    }
    .encabezado__etiqueta {
      font-size: 12px;
    }
  }
</style>
