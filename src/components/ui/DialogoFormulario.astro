---
/**
 * Ventana (<dialog>) con un formulario de HubSpot y su pantalla de gracias.
 * La abre cualquier elemento con data-abrir="<id>". Los campos van en el slot: sus `name` son
 * los nombres internos de las propiedades de contacto en HubSpot. Si hay un select [data-lada],
 * se antepone al valor de `phone` antes de enviar.
 */
import Boton from './Boton.astro';

interface Props {
  id: string;
  /** GUID del formulario de HubSpot */
  formulario: string;
  kicker: string;
  titulo: string;
  bajada: string;
  boton: string;
  exitoTitulo?: string;
  exitoTexto?: string;
}

const {
  id,
  formulario,
  kicker,
  titulo,
  bajada,
  boton,
  exitoTitulo = 'Gracias. Recibimos tu mensaje.',
  exitoTexto = 'Nuestro equipo se pondrá en contacto contigo.',
} = Astro.props;
---

<!-- data-lenis-prevent: el scroll suave de la página no debe robarse la rueda dentro del diálogo. -->
<dialog
  class="solicitud"
  id={id}
  aria-labelledby={`${id}-titulo`}
  data-dialogo-formulario
  data-formulario={formulario}
  data-lenis-prevent
>
  <div class="solicitud__caja">
    <button class="solicitud__cerrar" type="button" data-cerrar aria-label="Cerrar">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" />
      </svg>
    </button>

    <div class="solicitud__paso" data-paso="formulario">
      <p class="kicker solicitud__kicker">{kicker}</p>
      <h2 id={`${id}-titulo`} class="display solicitud__titulo">{titulo}</h2>
      <p class="solicitud__bajada">{bajada}</p>

      <form class="solicitud__form" data-form={id} novalidate>
        <slot />

        <div class="solicitud__acciones">
          <Boton type="submit">{boton}</Boton>
          <p class="solicitud__estado" role="status" aria-live="polite" hidden></p>
        </div>
      </form>
    </div>

    <div class="solicitud__paso solicitud__exito" data-paso="exito" role="status" hidden>
      <svg class="solicitud__check" viewBox="0 0 56 56" width="56" height="56" aria-hidden="true">
        <circle cx="28" cy="28" r="27" />
        <path d="M18 29l7 7 13-15" />
      </svg>
      <p class="display solicitud__titulo" tabindex="-1">{exitoTitulo}</p>
      <p class="solicitud__bajada">{exitoTexto}</p>
    </div>
  </div>
</dialog>

<script>
  import { enviarFormularioHubspot } from '../../lib/hubspot';

  const sinMovimiento = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLDialogElement>('dialog[data-dialogo-formulario]').forEach((dialogo) => {
    const form = dialogo.querySelector<HTMLFormElement>('form')!;
    const estado = dialogo.querySelector<HTMLParagraphElement>('.solicitud__estado')!;
    const pasoFormulario = dialogo.querySelector<HTMLDivElement>('[data-paso="formulario"]')!;
    const pasoExito = dialogo.querySelector<HTMLDivElement>('[data-paso="exito"]')!;
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    document.querySelectorAll(`[data-abrir="${dialogo.id}"]`).forEach((el) =>
      el.addEventListener('click', (evento) => {
        evento.preventDefault();
        dialogo.showModal();
      }),
    );
    dialogo.querySelectorAll('[data-cerrar]').forEach((el) => el.addEventListener('click', () => dialogo.close()));
    // Clic fuera de la caja cierra el diálogo.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });

    // Cambia el formulario por la ventana de gracias: la ventana se desvanece y reaparece más chica.
    async function mostrarExito() {
      if (!sinMovimiento()) {
        await dialogo.animate(
          [
            { opacity: 1, transform: 'none' },
            { opacity: 0, transform: 'scale(0.98)' },
          ],
          { duration: 160, easing: 'ease-in', fill: 'forwards' },
        ).finished;
      }
      pasoFormulario.hidden = true;
      pasoExito.hidden = false;
      dialogo.classList.add('solicitud--exito');
      dialogo.scrollTop = 0;
      pasoExito.querySelector<HTMLElement>('[tabindex="-1"]')?.focus({ preventScroll: true });
      dialogo.getAnimations().forEach((a) => a.cancel());
      if (!sinMovimiento()) {
        dialogo.animate(
          [
            { opacity: 0, transform: 'translateY(8px) scale(0.96)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 280, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
        );
      }
    }

    // Al cerrar después de enviar, deja el formulario limpio para la siguiente vez.
    dialogo.addEventListener('close', () => {
      if (!dialogo.classList.contains('solicitud--exito')) return;
      dialogo.classList.remove('solicitud--exito');
      form.reset();
      form.classList.remove('solicitud__form--revisar');
      estado.hidden = true;
      pasoFormulario.hidden = false;
      pasoExito.hidden = true;
    });

    function mostrar(texto: string) {
      estado.textContent = texto;
      estado.hidden = false;
    }

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!form.checkValidity()) {
        mostrar('Revisa los campos marcados.');
        form.classList.add('solicitud__form--revisar');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      boton?.setAttribute('disabled', '');
      try {
        const campos = Object.fromEntries([...new FormData(form)].map(([k, v]) => [k, String(v)]));
        const lada = form.querySelector<HTMLSelectElement>('[data-lada]')?.value;
        if (lada && campos.phone) campos.phone = `${lada} ${campos.phone.trim()}`;
        await enviarFormularioHubspot(dialogo.dataset.formulario ?? '', campos);
        await mostrarExito();
      } catch (error) {
        console.error(`Formulario ${dialogo.id}:`, error);
        mostrar('No pudimos enviar tu mensaje. Inténtalo de nuevo o escríbenos a info@revoluciondelariqueza.com.');
      } finally {
        boton?.removeAttribute('disabled');
      }
    });
  });
</script>

<!-- Global: los campos llegan por el slot y no reciben el scope de este componente. Todo va bajo .solicitud. -->
<style is:global>
  .solicitud {
    width: min(760px, 100% - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 1px solid var(--linea-oscura);
    border-radius: var(--radio-card);
    background: var(--fondo-tinta);
    color: var(--texto-claro);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .solicitud::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  .solicitud__caja {
    position: relative;
    padding: 40px;
  }

  .solicitud__cerrar {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--radio);
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .solicitud__cerrar:hover {
    color: var(--texto-claro);
    background: rgba(255, 255, 255, 0.06);
  }

  .solicitud__cerrar svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .solicitud__paso[hidden] {
    display: none;
  }

  .solicitud__kicker {
    color: var(--marca-hielo);
  }

  .solicitud__titulo {
    margin-top: 12px;
    font-size: clamp(30px, 4vw, 40px);
  }

  .solicitud__bajada {
    margin-top: 12px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 15px;
  }

  .solicitud__form {
    display: grid;
    gap: 28px;
    margin-top: 28px;
  }

  .solicitud__grupo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .solicitud__grupo legend {
    grid-column: 1 / -1;
    margin-bottom: 12px;
    color: var(--marca-hielo);
  }

  .solicitud label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
  }

  .solicitud__telefono {
    display: grid;
    gap: 6px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
  }

  .solicitud__telefono-campos {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
    gap: 8px;
  }

  .solicitud__ancho {
    grid-column: 1 / -1;
  }

  .solicitud input,
  .solicitud select,
  .solicitud textarea {
    width: 100%;
    min-height: 46px;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radio);
    background: rgba(255, 255, 255, 0.06);
    color: var(--texto-claro);
    font-family: var(--font-sans);
    font-size: 15px;
  }

  /* "Elige una opción" (desplegable sin elegir) en el mismo gris que los placeholders */
  .solicitud select:invalid {
    color: rgba(255, 255, 255, 0.4);
  }

  .solicitud select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, #fff 50%), linear-gradient(135deg, #fff 50%, transparent 50%);
    background-position:
      calc(100% - 18px) 50%,
      calc(100% - 13px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  .solicitud option {
    color: var(--texto-tinta);
  }

  .solicitud textarea {
    resize: vertical;
  }

  .solicitud input::placeholder,
  .solicitud textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .solicitud input:focus-visible,
  .solicitud select:focus-visible,
  .solicitud textarea:focus-visible {
    outline: 2px solid var(--marca-electrico-claro);
    outline-offset: 1px;
  }

  .solicitud__form--revisar :invalid {
    border-color: #ff9c8f;
  }

  .solicitud__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .solicitud__acciones button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .solicitud__estado {
    font-size: 14px;
    color: #ff9c8f;
  }

  /* Ventana de gracias: más angosta y centrada */
  .solicitud--exito {
    width: min(440px, 100% - 32px);
  }

  .solicitud__exito {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: 20px 8px;
  }

  .solicitud__exito .solicitud__titulo {
    margin-top: 24px;
    font-size: clamp(28px, 3.4vw, 34px);
    outline: none;
  }

  .solicitud__check {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .solicitud__check circle {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 1;
  }

  .solicitud__check path {
    stroke: var(--marca-electrico-claro);
    stroke-width: 2;
    stroke-dasharray: 32;
    stroke-dashoffset: 32;
  }

  .solicitud--exito .solicitud__check path {
    animation: solicitud-check 0.45s 0.18s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  @keyframes solicitud-check {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solicitud__check path {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 640px) {
    .solicitud__caja {
      padding: 28px 20px;
    }

    .solicitud__grupo {
      grid-template-columns: 1fr;
    }
  }
</style>
