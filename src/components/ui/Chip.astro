---
/** Chip (Figma · Componentes/Chip). Pastilla mono para credenciales y etiquetas. */
interface Props {
  tono?: 'oscuro' | 'claro';
  class?: string;
}
const { tono = 'oscuro', class: className } = Astro.props;
---

<span class:list={['chip', 'mini', `chip--${tono}`, className]}><slot /></span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 100px;
    border: 1px solid;
    white-space: nowrap;
  }

  .chip--oscuro {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.28);
    color: var(--texto-claro);
  }

  .chip--claro {
    background: rgba(17, 17, 17, 0.03);
    border-color: var(--linea-clara);
    color: var(--texto-tinta);
  }
</style>
