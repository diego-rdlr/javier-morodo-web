---
import { fechaCorta, hrefPagina, slicePagina, totalPaginas, type CategoriaLista, type Entrada } from '../../lib/blog';

interface Props {
  entradas: Entrada[];
  pagina: number;
  base: string;
  titulo: string;
  bajada: string;
  categorias: CategoriaLista[];
  categoriaActual?: string;
}

const { entradas, pagina, base, titulo, bajada, categorias, categoriaActual } = Astro.props;
const total = totalPaginas(entradas.length);
const visibles = slicePagina(entradas, pagina);
const paginas = Array.from({ length: total }, (_, i) => i + 1);
---

<main class="archivo">
  <div class="contenedor">
    <p class="kicker archivo__kicker">Blog</p>
    <h1 class="display archivo__titulo">{titulo}</h1>
    <p class="archivo__bajada">{bajada}</p>

    <nav class="archivo__filtros" aria-label="Categorías">
      <a class:list={['filtro', { 'filtro--activo': !categoriaActual }]} href="/blog/">Todos</a>
      {
        categorias.map((c) => (
          <a
            class:list={['filtro', { 'filtro--activo': c.slug === categoriaActual }]}
            href={`/category/${c.slug}/`}
          >
            {c.nombre}
            <span class="filtro__n">{c.total}</span>
          </a>
        ))
      }
    </nav>

    <ul class="archivo__grid">
      {
        visibles.map((entrada) => {
          const cat = entrada.data.categories[0];
          return (
            <li>
              <a class="tarjeta" href={`/${entrada.data.slug}/`}>
                <span class="tarjeta__foto">
                  {entrada.data.image ? (
                    <img
                      src={entrada.data.image}
                      alt=""
                      width={entrada.data.imageWidth}
                      height={entrada.data.imageHeight}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="tarjeta__vacio" aria-hidden="true" />
                  )}
                </span>
                <span class="tarjeta__meta mini">
                  {cat && <span class="tarjeta__cat">{cat.nombre}</span>}
                  <time datetime={entrada.data.date.slice(0, 10)}>{fechaCorta(entrada.data.date)}</time>
                </span>
                <span class="display tarjeta__titulo">{entrada.data.title}</span>
                <span class="tarjeta__texto">{entrada.data.description}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    {
      total > 1 && (
        <nav class="paginacion" aria-label="Paginación">
          {pagina > 1 ? (
            <a href={hrefPagina(base, pagina - 1)} rel="prev">
              ← Anterior
            </a>
          ) : (
            <span />
          )}
          <ol>
            {paginas.map((n) => (
              <li>
                <a href={hrefPagina(base, n)} aria-current={n === pagina ? 'page' : undefined}>
                  {n}
                </a>
              </li>
            ))}
          </ol>
          {pagina < total ? (
            <a href={hrefPagina(base, pagina + 1)} rel="next">
              Siguiente →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>
</main>

<style>
  .archivo {
    background: var(--fondo-blanco);
    color: var(--texto-tinta);
    padding: 56px 0 88px;
  }

  .archivo__kicker {
    color: var(--marca-electrico);
  }

  .archivo__titulo {
    max-width: 16em;
    margin-top: 14px;
    font-size: clamp(36px, 4vw, 56px);
  }

  .archivo__bajada {
    max-width: 46em;
    margin-top: 16px;
    color: var(--texto-tenue);
    font-size: 17px;
    line-height: 1.6;
  }

  .archivo__filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .filtro {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--linea-clara);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .filtro--activo {
    background: var(--texto-tinta);
    border-color: var(--texto-tinta);
    color: var(--texto-claro);
  }

  .filtro__n {
    opacity: 0.6;
  }

  .archivo__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 24px;
    margin-top: 36px;
  }

  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  .tarjeta__foto {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
    background: var(--fondo-crema);
  }

  .tarjeta__foto img,
  .tarjeta__vacio {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tarjeta:hover .tarjeta__titulo {
    color: var(--marca-electrico);
  }

  .tarjeta__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    color: var(--texto-tenue);
  }

  .tarjeta__cat {
    color: var(--marca-electrico);
  }

  .tarjeta__titulo {
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
  }

  .tarjeta__texto {
    color: var(--texto-tenue);
    font-size: 15px;
    line-height: 1.55;
  }

  .paginacion {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .paginacion > a:last-child {
    justify-self: end;
  }

  .paginacion ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .paginacion a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border-radius: 6px;
  }

  .paginacion a[aria-current='page'] {
    background: var(--texto-tinta);
    color: var(--texto-claro);
  }

  .paginacion a:hover {
    background: var(--fondo-crema);
  }

  @media (max-width: 980px) {
    .archivo__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .archivo {
      padding: 36px 0 64px;
    }

    .archivo__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .paginacion {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .paginacion > a:last-child {
      justify-self: center;
    }
  }
</style>
