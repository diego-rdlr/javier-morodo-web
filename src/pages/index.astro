import Confianza from '../components/sections/02-Confianza.astro';
import Cifras from '../components/sections/03-Cifras.astro';
import SobreJavier from '../components/sections/04-SobreJavier.astro';
import Trayectoria from '../components/sections/05-Trayectoria.astro';
import DondeHaTrabajado from '../components/sections/06-DondeHaTrabajado.astro';
import Conferencias from '../components/sections/07-Conferencias.astro';
import Educacion from '../components/sections/08-Educacion.astro';
import Libro from '../components/sections/09-Libro.astro';
import LanzamientoCoreX from '../components/sections/10-LanzamientoCoreX.astro';
import Contenido from '../components/sections/11-Contenido.astro';
import Podcast from '../components/sections/12-Podcast.astro';
