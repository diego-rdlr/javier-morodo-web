---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Boton from '../components/ui/Boton.astro';
import cielo from '../assets/img/shared/cielo.jpg';
import logo from '../assets/img/logos/javier-morodo-horizontal-light.svg';
---

<Base title="Página no encontrada · Javier Morodo" noindex>
  <main class="no-encontrada">
    <div class="capa no-encontrada__cielo" aria-hidden="true">
      <Image src={cielo} alt="" widths={[800, 1600]} sizes="100vw" loading="eager" />
    </div>
    <div class="contenedor no-encontrada__contenido">
      <a href="/"><Image src={logo} alt="Javier Morodo" width={182} height={39} loading="eager" /></a>
      <p class="kicker">Error 404</p>
      <h1 class="display display-l">Esta página no existe.</h1>
      <p>Puede que haya cambiado de lugar. Todo lo de Javier está en la página principal.</p>
      <Boton href="/">Ir al inicio</Boton>
    </div>
  </main>
</Base>

<style>
  .no-encontrada {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    align-items: center;
    background: var(--fondo-negro);
  }

  .no-encontrada__cielo {
    opacity: 0.5;
  }

  .no-encontrada__contenido {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-block: 80px;
  }

  .no-encontrada__contenido .kicker {
    margin-top: 40px;
    color: var(--marca-hielo);
  }
</style>
